# (2026-09 폐쇄망 포크) gemini-cli-ollama 환경변수 - bin/gemini가 실행할 때 읽는다.
# 셸에 이미 설정된 값이 있으면 그 값을 쓴다(아래는 기본값).
# 설명: 설계문서/OllamaContentGenerator_2026-09-30.md 2절

# Ollama 주소. 같은 서버면 localhost 대신 127.0.0.1 권장(IPv6로 다른 서비스에 붙는 것 방지)
export GEMINI_OLLAMA_BASE_URL="${GEMINI_OLLAMA_BASE_URL:-http://127.0.0.1:11434}"

# 대화용 모델 (ollama list로 확인)
export GEMINI_OLLAMA_MODEL="${GEMINI_OLLAMA_MODEL:-qwen3-coder:30b}"

# 화면 하단 모델 표시. auto로 두면 매 턴 라우터 호출이 추가돼 느려진다.
export GEMINI_MODEL="${GEMINI_MODEL:-$GEMINI_OLLAMA_MODEL}"

# 컨텍스트 길이. SQL 튜닝 REST API와 같은 값으로 맞춘다(다르면 모델을 다시 적재함).
export GEMINI_OLLAMA_NUM_CTX="${GEMINI_OLLAMA_NUM_CTX:-32768}"

# 답변 언어. 도구 호출 앞뒤 설명까지 한국어로 나오게 한다(GEMINI.md 지시만으로는 영어가 섞임). 지원 값: ko
export GEMINI_OLLAMA_RESPONSE_LANGUAGE="${GEMINI_OLLAMA_RESPONSE_LANGUAGE:-ko}"

# 대화 요청의 temperature. CLI 기본값(1)에서는 답변이 가끔 중국어·일본어로 나온다.
export GEMINI_OLLAMA_TEMPERATURE="${GEMINI_OLLAMA_TEMPERATURE:-0.3}"

# 선택 항목
# export GEMINI_OLLAMA_FAST_MODEL=qwen3-coder:30b   # 압축·요약 등 유틸리티 호출용 (GPU 1장이면 비워 두기)
# export GEMINI_OLLAMA_KEEP_ALIVE=30m              # 모델을 메모리에 유지하는 시간
# export GEMINI_OLLAMA_TIMEOUT_SECONDS=600         # 첫 조각까지·조각 사이 최대 대기
